# 数据库（本地开发用；部署平台按各自环境变量配置）
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Web Push 离线推送（可选增强）──────────────────────────────
# Netlify / Vercel 等只读文件系统部署时【强烈建议设置】：
# 不设置时服务端首次访问会自动生成密钥存到 .data/vapid.json（只读 FS 上每次冷启动会重新生成，
# 导致旧订阅全部失效、离线推送不可用）；设置后密钥跨部署/冷启动稳定。
# 生成方式（本地跑一次）：
#   bunx web-push generate-vapid-keys
# 然后把输出填到这里（也在 Netlify 后台 Site settings → Environment variables 里配一份）：
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# 可选：给 /api/push 加共享 token 鉴权（公网部署防第三方写入订阅表）；不设置 = 不启用
# PUSH_SHARED_TOKEN=
